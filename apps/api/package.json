{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc && tsc-alias",
    "lint": "eslint . --max-warnings 0",
    "watch:ts": "tsc -w",
    "watch:alias": "tsc-alias -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,Alias,App\" -c \"yellow.bold,green.bold,cyan.bold\" \"npm:watch:ts\" \"npm:watch:alias\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/types": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.1",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^16.5.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.8.17",
    "typescript": "~5.9.2"
  }
}
