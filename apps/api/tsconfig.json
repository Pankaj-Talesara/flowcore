{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@prisma-client": ["./src/lib/prisma.ts"],
      "@lib/*": ["./src/lib/*"]
    }
  },

  "include": ["src/**/*.ts"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
